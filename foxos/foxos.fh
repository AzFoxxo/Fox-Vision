// foxos.fh - public FoxOS application header
// -------------------------------------------
// Include this header to build a FoxOS foreground program. It exposes the
// application-facing OS ABI only:
//
//   Processes:  fork, exec, wait, exit, getpid, getppid, yield
//   Memory:     sbrk, malloc, free, calloc, realloc
//   Files:      open, close, read, write, lseek
//   Terminal:   tty_putc, tty_putc32, tty_getc, tty_puts, tty_newline,
//               tty_putu32
//   FoxFS:      fs_resolve_path, fs_create, fs_remove, fs_read_entry,
//               fs_write_entry, fs_data_base and the shared line[] buffer
//
// Programs are linked at 0x00100000. Globals live in the private data window
// at $A000-$EC77 and the heap starts at 0x20000000. A program must finish
// with exit()/os_return(); returning from main halts the machine.
//
// The syscall convention is documented in docs/abi.md:
//   R0 = number, R1..R6 = arguments, X = result, Y = errno.

#include <abi.fh>
#include <foxlib.fc>
