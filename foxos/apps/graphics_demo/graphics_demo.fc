// graphics_demo – 32-bit FoxOS foreground application
// Loaded in the FoxOS 32-bit program area (0x100000), launched by foxsh
// via "run /bin/graphics".
//
// Cycles a 16-color palette across a 100×50 (5000 pixel) block of VRAM,
// producing a smooth scrolling-gradient animation synced to vertical blank.
//
// VRAM is mapped at the top of the 16-bit word-address range (0xFFFF
// downwards); FoxOS addresses memory in 32-bit words with AM=0.
//
// This demo only uses FoxC built-ins (poke/vblank), so it does not need
// <foxos.fh>. Applications that use terminal, disk or FoxFS services should
// include it.

u32 VRAM_TOP = 65535;
u32 PIXELS   = 5000;
u32 phase    = 0;

// Return a 4-bit palette index for pixel idx at animation phase p.
u32 colorFor(u32 idx, u32 p)
{
    u32 v = idx + p;
    return v & 15;
}

// Paint a full frame into VRAM.
void drawFrame(u32 p)
{
    u32 addr = VRAM_TOP;
    u32 i    = 0;
    while (i < PIXELS)
    {
        poke(addr, colorFor(i, p));
        addr = addr - 1;
        i    = i + 1;
    }
}

// Wait for the next vertical-blank signal.
void waitVBlank()
{
    vblank();
}

void main()
{
    while (1)
    {
        drawFrame(phase);
        phase = (phase + 1) & 15;
        waitVBlank();
    }
}
