// edit – a nano-style full-screen text editor for FoxOS
//
// Built as a foreground program at 0x100000 and run from the shell with:
//
//   run /bin/edit
//
// Keys:
//   Arrow keys      move cursor (up/down/left/right)
//   Ctrl-A / Home   start of line
//   Ctrl-E / End    end of line
//   PageUp          scroll up one screen
//   PageDown        scroll down one screen
//   Enter           new line
//   Backspace       delete character left
//   Delete (^D)     delete character right
//   Ctrl-K          delete to end of line
//   Ctrl-L          redraw screen
//   Ctrl-S          save
//   Ctrl-Q          quit (press twice if unsaved changes)
//   Ctrl-X          quit (same as ^Q)
//
// Uses <foxos.fh> for terminal I/O and FoxFS file access.

#include <foxos.fh>

// ---------------------------------------------------------------------------
// Key codes - special keys sent by FoxVision as u16 values > 127
// ---------------------------------------------------------------------------
u16 KEY_UP       = 257;
u16 KEY_DOWN     = 258;
u16 KEY_RIGHT    = 259;
u16 KEY_LEFT     = 260;
u16 KEY_HOME     = 261;
u16 KEY_END      = 262;
u16 KEY_DELETE   = 263;
u16 KEY_PGUP     = 264;
u16 KEY_PGDN     = 265;

// ---------------------------------------------------------------------------
// Screen geometry: 80x24 terminal; last 2 rows = status + hint bar.
// ---------------------------------------------------------------------------
u16 ED_COLS      = 80;
u16 ED_ROWS      = 22;   // visible text rows
u16 ED_STATUS_ROW = 23;  // 1-based: title/status bar
u16 ED_HINT_ROW   = 24;  // 1-based: key hint bar

// ---------------------------------------------------------------------------
// Text buffer: ED_MAXLINES lines of at most ED_MAXLEN characters.
// Lines stored in one flat array.
// ---------------------------------------------------------------------------
u16 ED_MAXLINES  = 200;
u16 ED_MAXLEN    = 79;

u16 ed_text[16000];
u16 ed_len[200];
u16 ed_charmap[128];

// ---------------------------------------------------------------------------
// File and cursor state
// ---------------------------------------------------------------------------
u16 ed_name[64];
u16 ed_name_len = 0;
u32 ed_slot      = 0;
u16 ed_exists    = 0;

u16 ed_line       = 0;
u16 ed_col        = 0;
u16 ed_top        = 0;
u16 ed_line_count = 1;
u16 ed_dirty      = 0;
u16 ed_quit_once  = 0;
u16 ed_msg        = 0;  // 0=normal 1=saved 2=fail 3=quit?

// ---------------------------------------------------------------------------
// ANSI helpers – all escape sequences use tty_putc only (no tty_puts for esc)
// ---------------------------------------------------------------------------

void ed_csi(u16 p, u16 q, u16 ch)
{
    // Emit ESC [ p ; q ch  where p and q are at most 2-digit decimals
    tty_putc(27);
    tty_putc('[');
    if (p >= 10) { tty_putc('0' + p / 10); }
    tty_putc('0' + p - (p / 10) * 10);
    tty_putc(';');
    if (q >= 10) { tty_putc('0' + q / 10); }
    tty_putc('0' + q - (q / 10) * 10);
    tty_putc(ch);
}

void ed_gotoxy(u16 row, u16 col)
{
    ed_csi(row, col, 'H');
}

void ed_clear_screen()
{
    tty_putc(27); tty_putc('['); tty_putc('2'); tty_putc('J');
    tty_putc(27); tty_putc('['); tty_putc('H');
}

void ed_erase_eol()
{
    tty_putc(27); tty_putc('['); tty_putc('K');
}

void ed_set_reverse()
{
    tty_putc(27); tty_putc('['); tty_putc('7'); tty_putc('m');
}

void ed_set_normal()
{
    tty_putc(27); tty_putc('['); tty_putc('0'); tty_putc('m');
}

// Print a decimal integer with no leading zeros (simple, max 5 digits).
void ed_putu(u16 v)
{
    u16 d = 10000;
    u16 started = 0;
    u16 digit = 0;
    if (v == 0) { tty_putc('0'); return; }
    while (d > 0)
    {
        digit = v / d;
        if (digit != 0 || started != 0)
        {
            tty_putc('0' + digit);
            started = 1;
            v = v - digit * d;
        }
        d = d / 10;
    }
}

// ---------------------------------------------------------------------------
// Buffer helpers
// ---------------------------------------------------------------------------

void ed_clear_buf()
{
    u16 i = 0;
    while (i < ED_MAXLINES)
    {
        ed_len[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 128)
    {
        ed_charmap[i] = i;
        i = i + 1;
    }
    ed_line_count = 1;
    ed_line = 0;
    ed_col  = 0;
    ed_top  = 0;
}

void ed_copy_row(u16 dst, u16 src)
{
    u16 i = 0;
    while (i < ED_COLS)
    {
        ed_text[dst * ED_COLS + i] = ed_text[src * ED_COLS + i];
        i = i + 1;
    }
    ed_len[dst] = ed_len[src];
}

void ed_fix_top()
{
    if (ed_line < ed_top)
    {
        ed_top = ed_line;
    }
    if (ed_line >= ed_top + ED_ROWS)
    {
        ed_top = ed_line - ED_ROWS + 1;
    }
}

// ---------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------

void ed_move_left()
{
    if (ed_col > 0)
    {
        ed_col = ed_col - 1;
    }
    else
    {
        if (ed_line > 0)
        {
            ed_line = ed_line - 1;
            ed_col  = ed_len[ed_line];
        }
    }
}

void ed_move_right()
{
    if (ed_col < ed_len[ed_line])
    {
        ed_col = ed_col + 1;
    }
    else
    {
        if (ed_line + 1 < ed_line_count)
        {
            ed_line = ed_line + 1;
            ed_col  = 0;
        }
    }
}

void ed_move_up()
{
    if (ed_line > 0)
    {
        ed_line = ed_line - 1;
        if (ed_col > ed_len[ed_line]) { ed_col = ed_len[ed_line]; }
    }
}

void ed_move_down()
{
    if (ed_line + 1 < ed_line_count)
    {
        ed_line = ed_line + 1;
        if (ed_col > ed_len[ed_line]) { ed_col = ed_len[ed_line]; }
    }
}

void ed_home()
{
    ed_col = 0;
}

void ed_end()
{
    ed_col = ed_len[ed_line];
}

void ed_page_up()
{
    u16 i = 0;
    while (i < ED_ROWS && ed_line > 0)
    {
        ed_line = ed_line - 1;
        i = i + 1;
    }
    if (ed_col > ed_len[ed_line]) { ed_col = ed_len[ed_line]; }
}

void ed_page_down()
{
    u16 i = 0;
    while (i < ED_ROWS && ed_line + 1 < ed_line_count)
    {
        ed_line = ed_line + 1;
        i = i + 1;
    }
    if (ed_col > ed_len[ed_line]) { ed_col = ed_len[ed_line]; }
}

// ---------------------------------------------------------------------------
// Editing
// ---------------------------------------------------------------------------

void ed_insert(u16 ch)
{
    u16 l = ed_line;
    u16 n = ed_len[l];
    u16 i = n;
    if (n >= ED_MAXLEN) { return; }
    while (i > ed_col)
    {
        ed_text[l * ED_COLS + i] = ed_text[l * ED_COLS + i - 1];
        i = i - 1;
    }
    ed_text[l * ED_COLS + ed_col] = ch;
    ed_len[l] = n + 1;
    ed_col = ed_col + 1;
}

void ed_newline()
{
    u16 l    = ed_line;
    u16 n    = ed_len[l];
    u16 tail = n - ed_col;
    u16 i    = 0;
    u16 k    = 0;

    if (ed_line_count >= ED_MAXLINES) { return; }

    k = ed_line_count;
    while (k > l + 1)
    {
        ed_copy_row(k, k - 1);
        k = k - 1;
    }

    i = 0;
    while (i < tail)
    {
        ed_text[(l + 1) * ED_COLS + i] = ed_text[l * ED_COLS + ed_col + i];
        i = i + 1;
    }
    ed_len[l + 1] = tail;
    ed_len[l]     = ed_col;
    ed_line_count = ed_line_count + 1;
    ed_line = l + 1;
    ed_col  = 0;
}

void ed_backspace()
{
    u16 l = ed_line;
    u16 i = 0;
    u16 n = 0;

    if (ed_col > 0)
    {
        i = ed_col - 1;
        n = ed_len[l];
        while (i + 1 < n)
        {
            ed_text[l * ED_COLS + i] = ed_text[l * ED_COLS + i + 1];
            i = i + 1;
        }
        ed_len[l] = n - 1;
        ed_col = ed_col - 1;
        return;
    }

    if (l == 0) { return; }

    n = ed_len[l - 1] + ed_len[l];
    if (n > ED_MAXLEN) { return; }

    i = 0;
    while (i < ed_len[l])
    {
        ed_text[(l - 1) * ED_COLS + ed_len[l - 1] + i] = ed_text[l * ED_COLS + i];
        i = i + 1;
    }
    ed_col = ed_len[l - 1];
    ed_len[l - 1] = n;

    i = l;
    while (i + 1 < ed_line_count)
    {
        ed_copy_row(i, i + 1);
        i = i + 1;
    }
    ed_line_count = ed_line_count - 1;
    ed_line = l - 1;
}

void ed_delete_char()
{
    u16 l = ed_line;
    u16 n = ed_len[l];
    u16 i = ed_col;

    if (i < n)
    {
        while (i + 1 < n)
        {
            ed_text[l * ED_COLS + i] = ed_text[l * ED_COLS + i + 1];
            i = i + 1;
        }
        ed_len[l] = n - 1;
        return;
    }

    if (l + 1 >= ed_line_count) { return; }
    if (n + ed_len[l + 1] > ED_MAXLEN) { return; }

    i = 0;
    while (i < ed_len[l + 1])
    {
        ed_text[l * ED_COLS + n + i] = ed_text[(l + 1) * ED_COLS + i];
        i = i + 1;
    }
    ed_len[l] = n + ed_len[l + 1];

    i = l + 1;
    while (i + 1 < ed_line_count)
    {
        ed_copy_row(i, i + 1);
        i = i + 1;
    }
    ed_line_count = ed_line_count - 1;
}

void ed_kill_to_eol()
{
    ed_len[ed_line] = ed_col;
}

// ---------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------

void ed_render_status()
{
    u16 i = 0;

    // Status / title bar (row ED_STATUS_ROW) in reverse video
    ed_gotoxy(ED_STATUS_ROW, 1);
    ed_set_reverse();

    tty_putc(' ');
    tty_putc('e'); tty_putc('d'); tty_putc('i'); tty_putc('t');
    tty_putc(':'); tty_putc(' ');

    i = 0;
    while (i < ed_name_len && i < 24)
    {
        tty_putc(ed_name[i]);
        i = i + 1;
    }

    if (ed_dirty)
    {
        tty_putc(' ');
        tty_putc('*');
        tty_putc('*');
        tty_putc('*');
    }

    tty_putc(' ');
    tty_putc('-');
    tty_putc('-');
    tty_putc(' ');
    tty_putc('L');
    tty_putc('n');
    tty_putc(' ');
    ed_putu(ed_line + 1);
    tty_putc(',');
    tty_putc('C');
    tty_putc('o');
    tty_putc('l');
    tty_putc(' ');
    ed_putu(ed_col + 1);

    if (ed_msg == 1)
    {
        tty_putc(' ');
        tty_putc('-');
        tty_putc('-');
        tty_putc(' ');
        tty_putc('['); tty_putc('S'); tty_putc('a'); tty_putc('v'); tty_putc('e'); tty_putc('d'); tty_putc(']');
    }
    else
    {
        if (ed_msg == 2)
        {
            tty_putc(' ');
            tty_putc('['); tty_putc('S'); tty_putc('a'); tty_putc('v'); tty_putc('e'); tty_putc(' ');
            tty_putc('f'); tty_putc('a'); tty_putc('i'); tty_putc('l'); tty_putc('e'); tty_putc('d'); tty_putc(']');
        }
        else
        {
            if (ed_msg == 3)
            {
                tty_putc(' ');
                tty_putc('['); tty_putc('^'); tty_putc('Q'); tty_putc(' ');
                tty_putc('a'); tty_putc('g'); tty_putc('a'); tty_putc('i'); tty_putc('n'); tty_putc(' ');
                tty_putc('t'); tty_putc('o'); tty_putc(' ');
                tty_putc('q'); tty_putc('u'); tty_putc('i'); tty_putc('t'); tty_putc(']');
            }
        }
    }

    ed_erase_eol();
    ed_set_normal();

    // Hint bar (row ED_HINT_ROW)
    ed_gotoxy(ED_HINT_ROW, 1);
    ed_set_reverse();
    tty_putc(' ');
    tty_putc('^'); tty_putc('S'); tty_putc(' ');
    tty_putc('S'); tty_putc('a'); tty_putc('v'); tty_putc('e');
    tty_putc(' ');
    tty_putc(' ');
    tty_putc('^'); tty_putc('Q'); tty_putc('/'); tty_putc('^'); tty_putc('X'); tty_putc(' ');
    tty_putc('Q'); tty_putc('u'); tty_putc('i'); tty_putc('t');
    tty_putc(' ');
    tty_putc(' ');
    tty_putc('^'); tty_putc('K'); tty_putc(' ');
    tty_putc('C'); tty_putc('u'); tty_putc('t'); tty_putc(' '); tty_putc('L'); tty_putc('i'); tty_putc('n'); tty_putc('e');
    tty_putc(' ');
    tty_putc(' ');
    tty_putc('^'); tty_putc('L'); tty_putc(' ');
    tty_putc('R'); tty_putc('e'); tty_putc('d'); tty_putc('r'); tty_putc('a'); tty_putc('w');
    tty_putc(' ');
    tty_putc(' ');
    tty_putc('A'); tty_putc('r'); tty_putc('r'); tty_putc('o'); tty_putc('w'); tty_putc('s'); tty_putc(' ');
    tty_putc('N'); tty_putc('a'); tty_putc('v'); tty_putc('i'); tty_putc('g'); tty_putc('a'); tty_putc('t'); tty_putc('e');
    ed_erase_eol();
    ed_set_normal();
}

void ed_render()
{
    u16 r  = 0;
    u16 ln = 0;
    u16 i  = 0;
    u16 n  = 0;

    while (r < ED_ROWS)
    {
        ed_gotoxy(r + 1, 1);
        ln = ed_top + r;
        if (ln < ed_line_count)
        {
            n = ed_len[ln];
            if (n > ED_MAXLEN) { n = ED_MAXLEN; }
            i = 0;
            while (i < n)
            {
                tty_putc(ed_text[ln * ED_COLS + i]);
                i = i + 1;
            }
        }
        ed_erase_eol();
        r = r + 1;
    }

    ed_render_status();

    // Position the hardware cursor
    ed_gotoxy(ed_line - ed_top + 1, ed_col + 1);
}

// ---------------------------------------------------------------------------
// File I/O
// ---------------------------------------------------------------------------

void ed_load(u32 slot)
{
    u32 count = 0;
    u32 i     = 0;
    u32 w     = 0;
    u16 l     = 0;
    u16 c     = 0;
    u16 ch    = 0;
    u16 add   = 0;

    ed_clear_buf();

    fs_read_entry(slot);
    count = fs_e_size;
    if (count == 0) { return; }
    if (count > FILE_CHUNK_WORDS) { return; }

    disk_read_begin(fs_data_base(slot), count);
    while (i < count)
    {
        w = in_port32(6);
        i = i + 1;

        if (w == 13)
        {
            // ignore CR
        }
        else
        {
            if (w == 10)
            {
                if (l + 1 < ED_MAXLINES) { l = l + 1; c = 0; }
            }
            else
            {
                if (w == 9)
                {
                    add = 8 - (c - (c / 8) * 8);
                    while (add > 0)
                    {
                        if (c < ED_MAXLEN && l < ED_MAXLINES)
                        {
                            ed_text[l * ED_COLS + c] = ' ';
                            c = c + 1;
                        }
                        add = add - 1;
                    }
                }
                else
                {
                    if (w < 32 || w > 126) { ch = ' '; }
                    else                   { ch = ed_charmap[w]; }

                    if (c >= ED_MAXLEN)
                    {
                        if (l + 1 < ED_MAXLINES) { l = l + 1; c = 0; }
                    }
                    if (c < ED_MAXLEN && l < ED_MAXLINES)
                    {
                        ed_text[l * ED_COLS + c] = ch;
                        c = c + 1;
                        if (c > ed_len[l]) { ed_len[l] = c; }
                    }
                }
            }
        }
    }
    ed_line_count = l + 1;
}

u16 ed_save()
{
    u32 slot  = ed_slot;
    u32 count = 0;
    u32 i     = 0;
    u16 l     = 0;
    u16 c     = 0;

    i = 0;
    while (i < ed_name_len)
    {
        line[i] = ed_name[i];
        i = i + 1;
    }

    if (ed_exists == 0)
    {
        ed_gotoxy(1, 1);
        fs_create(0, ed_name_len, 1);
        slot = fs_resolve_path(0, ed_name_len);
        if (slot == ROOT_SLOT || slot == NOT_FOUND) { return 0; }
        fs_read_entry(slot);
        if (fs_e_type != 1) { return 0; }
        ed_slot   = slot;
        ed_exists = 1;
    }

    l = 0;
    while (l < ed_line_count)
    {
        count = count + ed_len[l];
        if (l + 1 < ed_line_count) { count = count + 1; }
        l = l + 1;
    }

    fs_read_entry(slot);
    fs_write_entry(slot, 1, fs_e_parent, fs_e_namelen, count);

    if (count == 0) { return 1; }

    disk_write_begin(fs_data_base(slot), count);
    l = 0;
    while (l < ed_line_count)
    {
        c = 0;
        while (c < ed_len[l])
        {
            out_port32(6, ed_text[l * ED_COLS + c]);
            c = c + 1;
        }
        if (l + 1 < ed_line_count) { out_port32(6, 10); }
        l = l + 1;
    }
    return 1;
}

// ---------------------------------------------------------------------------
// Startup prompts
// ---------------------------------------------------------------------------

void ed_read_name()
{
    u16 c = 0;
    line_len = 0;
    while (1)
    {
        c = tty_getc();
        if (c != 0)
        {
            if (c == 13 || c == 10)
            {
                tty_newline();
                return;
            }
            if (c == 8 || c == 127)
            {
                if (line_len > 0)
                {
                    line_len = line_len - 1;
                    tty_putc(8);
                    tty_putc(' ');
                    tty_putc(8);
                }
            }
            else
            {
                if (c >= 32 && c < 127)
                {
                    if (line_len < LINE_MAX - 1)
                    {
                        line[line_len] = c;
                        line_len = line_len + 1;
                        tty_putc(c);
                    }
                }
            }
        }
    }
}

void ed_pause()
{
    tty_putc(13); tty_putc(10);
    tty_putc('P'); tty_putc('r'); tty_putc('e'); tty_putc('s'); tty_putc('s');
    tty_putc(' '); tty_putc('a'); tty_putc(' ');
    tty_putc('k'); tty_putc('e'); tty_putc('y'); tty_putc('.');
    tty_putc('.');
    tty_putc('.');
    while (tty_getc() == 0) {}
}

void ed_exit()
{
    ed_clear_screen();
    os_return();
}

u16 ed_open()
{
    u16 i = 0;

    ed_name_len = line_len;
    while (ed_name_len > 0 && line[ed_name_len - 1] == ' ')
    {
        ed_name_len = ed_name_len - 1;
    }
    if (ed_name_len == 0) { return 1; }
    if (ed_name_len >= 64) { ed_name_len = 63; }

    i = 0;
    while (i < ed_name_len)
    {
        ed_name[i] = line[i];
        i = i + 1;
    }

    ed_slot = fs_resolve_path(0, ed_name_len);
    if (ed_slot == ROOT_SLOT || ed_slot == NOT_FOUND)
    {
        ed_slot   = NOT_FOUND;
        ed_exists = 0;
        ed_clear_buf();
        return 0;
    }
    fs_read_entry(ed_slot);
    if (fs_e_type != 1) { return 2; }

    ed_exists = 1;
    ed_load(ed_slot);
    ed_line = 0;
    ed_col  = 0;
    ed_top  = 0;
    return 0;
}

// ---------------------------------------------------------------------------
// Main editor loop
// ---------------------------------------------------------------------------

void ed_run()
{
    u16 c = 0;

    ed_render();
    while (1)
    {
        c = tty_getc();
        if (c != 0)
        {
            ed_msg = 0;

            // --- Save / quit ---
            if (c == 19)   // Ctrl-S
            {
                if (ed_save()) { ed_msg = 1; ed_dirty = 0; }
                else           { ed_msg = 2; }
            }
            if (c == 17 || c == 24)   // Ctrl-Q / Ctrl-X
            {
                if (ed_dirty == 0 || ed_quit_once) { ed_exit(); }
                ed_quit_once = 1;
                ed_msg       = 3;
            }

            // --- Arrow keys (sent as u16 > 127 by FoxVision) ---
            if (c == KEY_UP)    { ed_move_up(); }
            if (c == KEY_DOWN)  { ed_move_down(); }
            if (c == KEY_LEFT)  { ed_move_left(); }
            if (c == KEY_RIGHT) { ed_move_right(); }
            if (c == KEY_HOME)  { ed_home(); }
            if (c == KEY_END)   { ed_end(); }
            if (c == KEY_PGUP)  { ed_page_up(); }
            if (c == KEY_PGDN)  { ed_page_down(); }

            // Delete key (Forward delete)
            if (c == KEY_DELETE) { ed_delete_char(); ed_dirty = 1; }

            // --- Ctrl shortcuts ---
            if (c == 1)  { ed_home(); }          // Ctrl-A
            if (c == 5)  { ed_end(); }            // Ctrl-E
            if (c == 2)  { ed_move_left(); }      // Ctrl-B
            if (c == 6)  { ed_move_right(); }     // Ctrl-F
            if (c == 16) { ed_move_up(); }        // Ctrl-P
            if (c == 14) { ed_move_down(); }      // Ctrl-N
            if (c == 4)  { ed_delete_char(); ed_dirty = 1; }  // Ctrl-D
            if (c == 11) { ed_kill_to_eol(); ed_dirty = 1; }  // Ctrl-K
            if (c == 12) { ed_clear_screen(); }   // Ctrl-L redraw

            // --- Text editing ---
            if (c == 8 || c == 127)
            {
                ed_backspace();
                ed_dirty = 1;
            }
            if (c == 9)
            {
                // Tab: advance to next 4-stop
                u16 add = 4 - (ed_col - (ed_col / 4) * 4);
                while (add > 0)
                {
                    ed_insert(' ');
                    add = add - 1;
                }
                ed_dirty = 1;
            }
            if (c == 13 || c == 10)
            {
                ed_newline();
                ed_dirty = 1;
            }
            if (c >= 32 && c < 127)
            {
                ed_insert(c);
                ed_dirty = 1;
            }

            // Reset quit confirmation on any key except ^Q/^X
            if (c != 17 && c != 24) { ed_quit_once = 0; }

            ed_fix_top();
            ed_render();
        }
    }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

void main()
{
    u16 result = 0;

    ed_clear_screen();
    ed_gotoxy(1, 1);

    tty_putc('F'); tty_putc('o'); tty_putc('x'); tty_putc('O'); tty_putc('S');
    tty_putc(' ');
    tty_putc('e'); tty_putc('d'); tty_putc('i'); tty_putc('t');
    tty_putc(13); tty_putc(10); tty_putc(13); tty_putc(10);
    tty_putc('F'); tty_putc('i'); tty_putc('l'); tty_putc('e'); tty_putc(':');
    tty_putc(' ');

    ed_read_name();
    result = ed_open();

    if (result == 1)
    {
        tty_putc('N'); tty_putc('o'); tty_putc(' ');
        tty_putc('f'); tty_putc('i'); tty_putc('l'); tty_putc('e');
        tty_putc(' ');
        tty_putc('n'); tty_putc('a'); tty_putc('m'); tty_putc('e');
        tty_putc('.');
        ed_pause();
        ed_exit();
    }
    if (result == 2)
    {
        tty_putc('T'); tty_putc('h'); tty_putc('a'); tty_putc('t');
        tty_putc(' ');
        tty_putc('i'); tty_putc('s'); tty_putc(' ');
        tty_putc('a'); tty_putc(' ');
        tty_putc('d'); tty_putc('i'); tty_putc('r'); tty_putc('e');
        tty_putc('c'); tty_putc('t'); tty_putc('o'); tty_putc('r');
        tty_putc('y'); tty_putc('.');
        ed_pause();
        ed_exit();
    }

    ed_run();
}
