// FoxOS Filesystem (foxfs) – 32-bit layout on VF32HardDisk
//
// The cartridge is byte-addressed but FoxOS uses it as an array of 32-bit
// words. Every metadata field, slot index and file data unit is 32 bits wide.
// All path functions operate on the global line[] / line_len from kernel.fc.
//
// Disk layout (32-bit word indices):
//   0              magic (0x464F5833, "FOX3")
//   1              version (8)
//   2              entry count (512)
//   3              first data word (10244)
//   4..2051        entry records, 4 words each for slots 0..511:
//                    +0 type: 0=free 1=program 2=directory 3=text
//                    +1 parent slot (ROOT_SLOT means the root directory)
//                    +2 name length
//                    +3 size: words for type 1, bytes for type 3
//   2052..10243    entry names (16 words/slot, one ASCII char per word)
//   10244..        file data, one FILE_CHUNK_WORDS block per slot
//
// Keeping each entry's metadata in one four-word record means a lookup only
// needs a single four-word disk transaction per slot instead of three separate
// table reads.
//
// foxfs_api.fc is the application-facing API (also exposed by <foxos.fh>);
// foxfs_internal.fc holds formatting, validation and shell-only commands.

#include "foxfs_api.fc"
#include "foxfs_internal.fc"
