// Resident harness for the editor ABI regression test.
//
// Formats a fresh disk, creates the file the embedded editor program opens,
// then launches that program as the first user process.

#include <kernel/kernel.fc>
#include <foxfs/foxfs.fc>
#include <kernel/abi.fc>

u8 editor_test_name[8] = "EDITTXT";

void main()
{
    u16 i = 0;
    u32 slot = 0;

    abi_init();

    if (fs_valid() == 0)
    {
        fs_format();
    }

    if (peek(EMBED_BASE) != EMBED_MAGIC)
    {
        tty_puts("FAIL editor (no embedded program)\r\n");
        return;
    }

    line_len = 7;
    while (i < 7)
    {
        line[i] = editor_test_name[i];
        i = i + 1;
    }

    slot = fs_create(0, 7, 1);
    if (slot == ROOT_SLOT || slot == NOT_FOUND)
    {
        tty_puts("FAIL editor (create)\r\n");
        return;
    }
    fs_write_entry(slot, 1, ROOT_SLOT, 7, 7);
    disk_write_begin(fs_data_base(slot), 7);
    i = 0;
    while (i < 7)
    {
        out_port32(6, editor_test_name[i]);
        i = i + 1;
    }

    abi_start_embedded(EMBED_BASE + EMBED_DATA_OFFSET,
                       peek(EMBED_BASE + EMBED_LEN_OFFSET));
}
