// Editor ABI regression: foreground program.
//
// Exercises the editor's file load, save and exit paths entirely through the
// public <foxos.fh> application API. The resident harness formats the disk,
// creates a small file and embeds this program as the first user process.

#include <apps/edit/edit_core.fc>

u8 ed_original[8] = "EDITTXT";
u8 ed_saved[8]    = "FDITTXT";

void ed_test_fail(u8 *message)
{
    tty_puts("FAIL editor ");
    tty_puts(message);
    tty_puts("\r\n");
    exit(1);
}

void main()
{
    u16 i = 0;
    u32 slot = 0;
    u32 word = 0;

    // ed_open() takes the file name from the shared line[] buffer.
    line_len = 7;
    while (i < 7)
    {
        line[i] = ed_original[i];
        i = i + 1;
    }

    if (ed_open() != 0) { ed_test_fail("open"); }
    if (ed_len[0] != 7) { ed_test_fail("load length"); }

    i = 0;
    while (i < 7)
    {
        if (ed_text[i] != ed_original[i]) { ed_test_fail("load data"); }
        i = i + 1;
    }

    // Edit the first character, then save through the public ABI.
    ed_text[0] = 'F';
    ed_dirty = 1;
    if (ed_save() == 0) { ed_test_fail("save"); }

    // Read the file back with the same public API the editor uses.
    slot = fs_resolve_path(0, 7);
    if (slot == NOT_FOUND) { ed_test_fail("resolve"); }
    fs_read_entry(slot);
    if (fs_e_type != FILE_TEXT) { ed_test_fail("saved type"); }
    if (fs_e_size != 7) { ed_test_fail("saved size"); }

    disk_bytes_read_begin(fs_data_base(slot), 7);
    i = 0;
    while (i < 7)
    {
        word = disk_bytes_read();
        if (word != ed_saved[i]) { ed_test_fail("saved data"); }
        i = i + 1;
    }

    tty_puts("PASS EDITOR\r\n");
    exit(0);
}
