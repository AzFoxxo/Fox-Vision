// foxlib.fc - FoxOS user-mode C library
// --------------------------------------
// This is the application side of the FoxOS ABI. It provides the familiar
// terminal, FoxFS and allocation calls on top of the ISA V2.2 trap interface:
//
//   R0 = syscall number, R1..R6 = arguments
//   X  = result, Y = error number
//
// Applications are linked at 0x00100000 and use private data ($A000-$EC77)
// and heap (0x20000000-0x203FFFFF) windows set up by the kernel.

#include <abi.fh>

// ---------------------------------------------------------------------------
// Shared globals expected by existing FoxOS applications
// ---------------------------------------------------------------------------

u16 line[64];
u16 line_len = 0;
u16 LINE_MAX = 64;

u32 fs_e_type = 0;
u32 fs_e_parent = 0;
u32 fs_e_namelen = 0;
u32 fs_e_size = 0;

u32 ROOT_SLOT        = 512;
u32 NOT_FOUND        = 513;
u32 ENTRY_COUNT      = 512;
u32 ENTRY_WORDS      = 4;
u32 ENTRY_TYPE       = 0;
u32 ENTRY_PARENT     = 1;
u32 ENTRY_NAMELEN    = 2;
u32 ENTRY_SIZE       = 3;
u32 NAME_TABLE_BASE  = 2052;
u32 NAMES_PER_SLOT   = 16;
u32 DATA_BASE        = 10244;
u32 FILE_CHUNK_WORDS = 0x1FF000;
// FoxFS entry types: word-packed program, directory, byte-packed text.
u32 FILE_PROGRAM     = 1;
u32 FILE_DIR         = 2;
u32 FILE_TEXT        = 3;

// ---------------------------------------------------------------------------
// Raw terminal / disk helpers
//
// The character devices are memory-mapped ports, so single-byte terminal I/O
// does not need a trip through the kernel. Bulk terminal writes use the
// write() syscall below.
// ---------------------------------------------------------------------------

void tty_putc(u16 c)
{
    out_port(4, c);
}

void tty_putc32(u32 c)
{
    out_port32(4, c);
}

u16 tty_getc()
{
    return in_port(4);
}

void tty_newline()
{
    out_port(4, '\r');
    out_port(4, '\n');
}

void tty_putu32(u32 value)
{
    u32 divisor = 1000000000;
    u16 started = 0;
    u32 digit = 0;

    if (value == 0)
    {
        tty_putc('0');
        return;
    }
    while (divisor > 0)
    {
        digit = value / divisor;
        if (digit != 0 || started != 0)
        {
            tty_putc32('0' + digit);
            started = 1;
            value = value - digit * divisor;
        }
        divisor = divisor / 10;
    }
}

// ---------------------------------------------------------------------------
// Syscall wrappers
// ---------------------------------------------------------------------------

u32 write(u32 fd, u8 *buf, u32 count)
{
    return syscall(SYS_WRITE, fd, (u32)buf, count, 0, 0, 0);
}

u32 read(u32 fd, u8 *buf, u32 count)
{
    return syscall(SYS_READ, fd, (u32)buf, count, 0, 0, 0);
}

u32 open(u8 *path, u32 flags)
{
    return syscall(SYS_OPEN, (u32)path, flags, 0, 0, 0, 0);
}

u32 close(u32 fd)
{
    return syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
}

u32 lseek(u32 fd, u32 offset)
{
    return syscall(SYS_LSEEK, fd, offset, 0, 0, 0, 0);
}

u32 sbrk(u32 increment)
{
    return syscall(SYS_SBRK, increment, 0, 0, 0, 0, 0);
}

u32 getpid()
{
    return syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0);
}

u32 getppid()
{
    return syscall(SYS_GETPPID, 0, 0, 0, 0, 0, 0);
}

u32 fork()
{
    return syscall(SYS_FORK, 0, 0, 0, 0, 0, 0);
}

u32 exec(u8 *path)
{
    return syscall(SYS_EXEC, (u32)path, 0, 0, 0, 0, 0);
}

// POSIX waitpid(pid, &status). pid = 0 waits for any child.
u32 waitpid(u32 pid, u32 *status)
{
    return syscall(SYS_WAIT, pid, (u32)status, 0, 0, 0, 0);
}

void yield()
{
    syscall(SYS_YIELD, 0, 0, 0, 0, 0, 0);
}

void exit(u32 status)
{
    syscall(SYS_EXIT, status, 0, 0, 0, 0, 0);
}

void tty_puts(u8 *text)
{
    u32 n = 0;
    u8 *p = text;

    while (*p != 0)
    {
        n = n + 1;
        p = p + 1;
    }
    if (n != 0)
    {
        write(ABI_STDOUT, text, n);
    }
}

// ---------------------------------------------------------------------------
// FoxFS compatibility layer
//
// Paths and entry metadata are still expressed with the global line[] buffer,
// exactly as the kernel API does. Each wrapper marshals that state through a
// syscall so the kernel can operate on the process's private data window.
// ---------------------------------------------------------------------------

u32 fs_data_base(u32 slot)
{
    return DATA_BASE + slot * FILE_CHUNK_WORDS;
}

void disk_read_begin(u32 word, u32 count)
{
    out_port32(6, word * 4);
    out_port32(6, (count - 1) << 1);
}

void disk_write_begin(u32 word, u32 count)
{
    out_port32(6, word * 4);
    out_port32(6, ((count - 1) << 1) | 1);
}

u32 disk_read(u32 word)
{
    disk_read_begin(word, 1);
    return in_port32(6);
}

void disk_write(u32 word, u32 value)
{
    disk_write_begin(word, 1);
    out_port32(6, value);
}

// Byte-packed text I/O: four ASCII bytes are packed into each 32-bit disk
// word (little-endian), so host file managers see ordinary text files.
u32 db_read_left      = 0;
u32 db_read_index     = 0;
u32 db_read_value     = 0;
u32 db_read_need_word = 0;
u32 db_write_left     = 0;
u32 db_write_index    = 0;
u32 db_write_value    = 0;

void disk_bytes_read_at(u32 word, u32 byte_offset, u32 byte_count)
{
    db_read_left = byte_count;
    db_read_index = byte_offset;
    db_read_value = 0;
    db_read_need_word = 1;
    if (byte_count != 0)
    {
        disk_read_begin(word + byte_offset / 4,
                        ((byte_offset - (byte_offset / 4) * 4) + byte_count + 3) / 4);
    }
}

void disk_bytes_read_begin(u32 word, u32 byte_count)
{
    disk_bytes_read_at(word, 0, byte_count);
}

u16 disk_bytes_read()
{
    u16 byte = 0;

    if (db_read_left == 0) { return 0; }
    if (db_read_need_word != 0 || (db_read_index & 3) == 0)
    {
        db_read_value = in_port32(6);
        db_read_need_word = 0;
    }
    byte = (u16)((db_read_value >> ((db_read_index & 3) * 8)) & 0xFF);
    db_read_index = db_read_index + 1;
    db_read_left = db_read_left - 1;
    return byte;
}

void disk_bytes_write_at(u32 word, u32 byte_offset, u32 byte_count)
{
    u32 shift = (byte_offset - (byte_offset / 4) * 4);
    u32 mask = 0;

    db_write_left = byte_count;
    db_write_index = byte_offset;
    db_write_value = 0;
    if (byte_count == 0) { return; }
    if (shift != 0)
    {
        disk_read_begin(word + byte_offset / 4, 1);
        db_write_value = in_port32(6);
        while (shift > 0)
        {
            mask = (mask << 8) | 0xFF;
            shift = shift - 1;
        }
        db_write_value = db_write_value & mask;
    }
    disk_write_begin(word + byte_offset / 4,
                     ((byte_offset - (byte_offset / 4) * 4) + byte_count + 3) / 4);
}

void disk_bytes_write_begin(u32 word, u32 byte_count)
{
    disk_bytes_write_at(word, 0, byte_count);
}

void disk_bytes_write(u16 byte)
{
    if (db_write_left == 0) { return; }
    db_write_value = db_write_value |
                     (((u32)byte & 0xFF) << ((db_write_index & 3) * 8));
    db_write_index = db_write_index + 1;
    db_write_left = db_write_left - 1;
    if ((db_write_index & 3) == 0 || db_write_left == 0)
    {
        out_port32(6, db_write_value);
        db_write_value = 0;
    }
}

u32 fs_resolve_path(u16 start, u16 end)
{
    return syscall(SYS_FS_RESOLVE, (u32)&line[0], start, end, 0, 0, 0);
}

u32 fs_create(u16 start, u16 end, u32 type)
{
    return syscall(SYS_FS_CREATE, (u32)&line[0], start, end, type, 0, 0);
}

u16 fs_remove(u16 start, u16 end)
{
    return (u16)syscall(SYS_FS_REMOVE, (u32)&line[0], start, end, 0, 0, 0);
}

void fs_read_entry(u32 slot)
{
    syscall(SYS_FS_ENTRY, slot, (u32)&fs_e_type, (u32)&fs_e_parent,
            (u32)&fs_e_namelen, (u32)&fs_e_size, 0);
}

void fs_write_entry(u32 slot, u32 type, u32 parent, u32 namelen, u32 size)
{
    syscall(SYS_FS_WRITE_ENTRY, slot, type, parent, namelen, size, 0);
}

// ---------------------------------------------------------------------------
// malloc / free
//
// The allocator is a first-fit free list backed by sbrk(). Every block has a
// three-word header: size (including the header) followed by the next-free
// pointer. u8 pointers are word-scaled in em2_am1 mode, so the sizes stay in
// words and match the byte counts applications expect.
// ---------------------------------------------------------------------------

u32 fox_free_head = 0;

u32 fox_peek32(u32 addr)
{
    return (u32)peek(addr) | (((u32)peek(addr + 1)) << 16);
}

void fox_poke32(u32 addr, u32 value)
{
    poke(addr, value & 0xFFFF);
    poke(addr + 1, (value >> 16) & 0xFFFF);
}

u8 *malloc(u32 size)
{
    u32 need = size + 3;
    u32 prev = 0;
    u32 cur = fox_free_head;
    u32 block = 0;
    u32 block_size = 0;
    u32 block_next = 0;

    // First fit.
    while (cur != 0)
    {
        block_size = fox_peek32(cur);
        if (block_size >= need)
        {
            block_next = fox_peek32(cur + 1);
            if (prev == 0)
            {
                fox_free_head = block_next;
            }
            else
            {
                fox_poke32(prev + 1, block_next);
            }
            fox_poke32(cur, block_size);
            return (u8 *)(cur + 3);
        }
        prev = cur;
        cur = fox_peek32(cur + 1);
    }

    block = sbrk(need);
    if (block == SYS_ERR)
    {
        return (u8 *)0;
    }
    fox_poke32(block, need);
    fox_poke32(block + 1, 0);
    return (u8 *)(block + 3);
}

void free(u8 *ptr)
{
    u32 block = 0;

    if (ptr == (u8 *)0)
    {
        return;
    }
    block = (u32)ptr - 3;
    fox_poke32(block + 1, fox_free_head);
    fox_free_head = block;
}

u8 *calloc(u32 size)
{
    u8 *ptr = malloc(size);
    u32 i = 0;

    if (ptr == (u8 *)0)
    {
        return ptr;
    }
    while (i < size)
    {
        *(ptr + i) = 0;
        i = i + 1;
    }
    return ptr;
}

u8 *realloc(u8 *ptr, u32 size)
{
    u8 *next = (u8 *)0;
    u32 old_size = 0;
    u32 copy_words = 0;
    u32 i = 0;

    if (ptr == (u8 *)0)
    {
        return malloc(size);
    }
    next = malloc(size);
    if (next == (u8 *)0)
    {
        return next;
    }
    old_size = fox_peek32((u32)ptr - 3);
    copy_words = old_size - 3;
    if (size < copy_words)
    {
        copy_words = size;
    }
    while (i < copy_words)
    {
        *(next + i) = *(ptr + i);
        i = i + 1;
    }
    free(ptr);
    return next;
}
