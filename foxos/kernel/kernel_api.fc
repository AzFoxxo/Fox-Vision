// FoxOS kernel public API — the hardware services available to applications.
//
// Included by <foxos.fh> for foreground programs, and by kernel.fc for the
// resident kernel, shell and test images. Nothing here is shell-specific.

// ---------------------------------------------------------------------------
// Hardware constants
//
// in_port32/out_port32 require compile-time port numbers, so the disk and TTY
// helpers use the literals 4 and 6 directly.
// ---------------------------------------------------------------------------

u16 PORT_TTY  = 4;
u16 PORT_DISK = 6;
// ---------------------------------------------------------------------------
// Shared input buffer (used by foxfs path ops and foxsh REPL)
// ---------------------------------------------------------------------------

u16 line[64];
u16 line_len = 0;
u16 LINE_MAX = 64;

// ---------------------------------------------------------------------------
// VF32HardDisk I/O
//
// The cartridge is byte-addressed but transfers one 32-bit word per bus
// cycle. FoxOS therefore addresses it in 32-bit words: word N is at byte
// offset N * 4. A transaction is:
//
//   1. 32-bit address word
//   2. 32-bit command word: bit 0 = write, bits 1..31 = count - 1
//   3. one 32-bit data word per transfer
//
// disk_read() and disk_write() are the single-word helpers used by the
// filesystem metadata. disk_read_begin()/disk_write_begin() start a block
// transaction for program loading and installation.
// ---------------------------------------------------------------------------

void disk_read_begin(u32 word, u32 count)
{
    out_port32(6, word * 4);
    out_port32(6, (count - 1) << 1);
}

void disk_write_begin(u32 word, u32 count)
{
    out_port32(6, word * 4);
    out_port32(6, ((count - 1) << 1) | 1);
}

u32 disk_read(u32 word)
{
    disk_read_begin(word, 1);
    return in_port32(6);
}

void disk_write(u32 word, u32 value)
{
    disk_write_begin(word, 1);
    out_port32(6, value);
}

// Byte-packed text I/O: four ASCII bytes are packed into each 32-bit disk
// word (little-endian), so host file managers see ordinary text files.
u32 db_read_left      = 0;
u32 db_read_index     = 0;
u32 db_read_value     = 0;
u32 db_read_need_word = 0;
u32 db_write_left     = 0;
u32 db_write_index    = 0;
u32 db_write_value    = 0;

void disk_bytes_read_at(u32 word, u32 byte_offset, u32 byte_count)
{
    db_read_left = byte_count;
    db_read_index = byte_offset;
    db_read_value = 0;
    db_read_need_word = 1;
    if (byte_count != 0)
    {
        disk_read_begin(word + byte_offset / 4,
                        ((byte_offset - (byte_offset / 4) * 4) + byte_count + 3) / 4);
    }
}

void disk_bytes_read_begin(u32 word, u32 byte_count)
{
    disk_bytes_read_at(word, 0, byte_count);
}

u16 disk_bytes_read()
{
    u16 byte = 0;

    if (db_read_left == 0) { return 0; }
    if (db_read_need_word != 0 || (db_read_index & 3) == 0)
    {
        db_read_value = in_port32(6);
        db_read_need_word = 0;
    }
    byte = (u16)((db_read_value >> ((db_read_index & 3) * 8)) & 0xFF);
    db_read_index = db_read_index + 1;
    db_read_left = db_read_left - 1;
    return byte;
}

void disk_bytes_write_at(u32 word, u32 byte_offset, u32 byte_count)
{
    u32 shift = (byte_offset - (byte_offset / 4) * 4);
    u32 mask = 0;

    db_write_left = byte_count;
    db_write_index = byte_offset;
    db_write_value = 0;
    if (byte_count == 0) { return; }
    if (shift != 0)
    {
        disk_read_begin(word + byte_offset / 4, 1);
        db_write_value = in_port32(6);
        while (shift > 0)
        {
            mask = (mask << 8) | 0xFF;
            shift = shift - 1;
        }
        db_write_value = db_write_value & mask;
    }
    disk_write_begin(word + byte_offset / 4,
                     ((byte_offset - (byte_offset / 4) * 4) + byte_count + 3) / 4);
}

void disk_bytes_write_begin(u32 word, u32 byte_count)
{
    disk_bytes_write_at(word, 0, byte_count);
}

void disk_bytes_write(u16 byte)
{
    if (db_write_left == 0) { return; }
    db_write_value = db_write_value |
                     (((u32)byte & 0xFF) << ((db_write_index & 3) * 8));
    db_write_index = db_write_index + 1;
    db_write_left = db_write_left - 1;
    if ((db_write_index & 3) == 0 || db_write_left == 0)
    {
        out_port32(6, db_write_value);
        db_write_value = 0;
    }
}

// ---------------------------------------------------------------------------
// Terminal I/O
// ---------------------------------------------------------------------------

void tty_putc(u16 c)
{
    out_port(4, c);
}

// Print a character that came from a 32-bit source word (for example a
// filesystem name entry).
void tty_putc32(u32 c)
{
    out_port32(4, c);
}

// Print an unsigned 32-bit value in decimal.
void tty_putu32(u32 value)
{
    u32 divisor = 1000000000;
    u16 started = 0;
    u32 digit = 0;

    if (value == 0)
    {
        tty_putc('0');
        return;
    }
    while (divisor > 0)
    {
        digit = value / divisor;
        if (digit != 0 || started != 0)
        {
            tty_putc32('0' + digit);
            started = 1;
            value = value - digit * divisor;
        }
        divisor = divisor / 10;
    }
}

void tty_puts(u8 *text)
{
    while (*text != 0)
    {
        out_port(4, *text);
        text = text + 1;
    }
}

u16 tty_getc()
{
    return in_port(4);
}

void tty_newline()
{
    out_port(4, '\r');
    out_port(4, '\n');
}
