// FoxOS 32-bit kernel – hardware abstraction layer
//
// Built for the V2.0 ISA with --mode em2_am1:
//   EM = 2   full 32-bit register and address bus
//   AM = 0   word addressing (one address unit = one 16-bit word)
//
// Ports:  4 = VF16TTY (terminal)
//         6 = VF32HardDisk (4 GiB, 32-bit bus)
//
// The public application interface lives in kernel_api.fc (also exposed by
// <foxos.fh>); kernel_internal.fc holds resident-kernel and shell-only
// helpers such as the program loader and embedded-image layout constants.

#include "kernel_api.fc"
#include "kernel_internal.fc"
