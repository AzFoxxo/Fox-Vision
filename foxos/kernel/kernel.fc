// FoxOS Kernel – hardware abstraction layer
// Ports:  4 = VF16TTY (terminal)   5 = VF16Flash (cartridge)
//
// Shared globals line[] and line_len live here so both foxfs and foxsh
// can use them after this file is prepended in the build.

// ---------------------------------------------------------------------------
// Hardware constants
//
// out_port/in_port require compile-time port numbers, so the I/O helpers use
// the literals 4 (TTY) and 5 (flash) directly.
// ---------------------------------------------------------------------------

u16 PORT_TTY      = 4;
u16 PORT_FLASH    = 5;

// ---------------------------------------------------------------------------
// Address constants
// ---------------------------------------------------------------------------

u16 PROGRAM_BASE     = 16384;  // 0x4000 – foreground program load address
u16 EMBED_BASE       = 28672;  // 0x7000 – foxos_pack embedded header
u16 EMBED_MAGIC      = 61527;  // 0xF057
u16 EMBED_NAME_MAX   = 8;
u16 EMBED_LEN_OFFSET = 10;
u16 EMBED_DATA_OFFSET = 11;

// ---------------------------------------------------------------------------
// Shared input buffer (used by foxfs path ops and foxsh REPL)
// ---------------------------------------------------------------------------

u16 line[32];
u16 line_len = 0;
u16 LINE_MAX = 32;

// ---------------------------------------------------------------------------
// Flash I/O
// ---------------------------------------------------------------------------

u16 flash_read(u16 address)
{
    out_port(5, address * 2);
    return in_port(5);
}

void flash_write(u16 address, u16 value)
{
    out_port(5, address * 2 + 1);
    out_port(5, value);
}

// ---------------------------------------------------------------------------
// Terminal I/O
// ---------------------------------------------------------------------------

void tty_putc(u16 c)
{
    out_port(4, c);
}

void tty_puts(u8 *text)
{
    while (*text != 0)
    {
        out_port(4, *text);
        text = text + 1;
    }
}

u16 tty_getc()
{
    return in_port(4);
}

void tty_newline()
{
    out_port(4, '\r');
    out_port(4, '\n');
}

// ---------------------------------------------------------------------------
// Program loader – copy words from flash to RAM then hand off execution
// ---------------------------------------------------------------------------

void kernel_exec(u16 flash_offset, u16 word_count)
{
    u16 i = 0;
    u16 dest = PROGRAM_BASE;
    while (i < word_count)
    {
        poke(dest, flash_read(flash_offset + i));
        dest = dest + 1;
        i = i + 1;
    }
    os_start(16384);
}

// Copy a program that lives in the ROM image (for example the embedded
// program placed at EMBED_BASE by foxos_pack.py). ROM contents are read
// with peek(), not through the flash device.
void kernel_exec_embedded(u16 rom_offset, u16 word_count)
{
    u16 i = 0;
    u16 dest = PROGRAM_BASE;
    while (i < word_count)
    {
        poke(dest, peek(rom_offset + i));
        dest = dest + 1;
        i = i + 1;
    }
    os_start(16384);
}

// ---------------------------------------------------------------------------
// Banner
// ---------------------------------------------------------------------------

void kernel_banner()
{
    tty_puts("FoxOS kernel v0.1 - Fox16 extended mode\r\n");
}
