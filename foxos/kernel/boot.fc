// FoxOS 32-bit boot entry – resident kernel image (kernel + foxfs)
//
// This file supplies main() for the kernel image only. The interactive
// shell lives in foxsh/foxsh.fc and is built as a separate image
// (foxsh.bin), so it is never linked into the resident kernel.
// The full kernel and FoxFS modules supply the resident-kernel support code
// (including the formatter, which the application header does not expose).

#include <kernel/kernel.fc>
#include <foxfs/foxfs.fc>
#include <kernel/abi.fc>

void main()
{
    abi_init();
    kernel_banner();

    if (fs_valid() == 0)
    {
        tty_puts("Filesystem not found - formatting VF32HardDisk...\r\n");
        fs_format();
        tty_puts("Done.\r\n");
    }
    else
    {
        tty_puts("VF32HardDisk filesystem OK.\r\n");
    }

    // If foxos_pack embedded a foreground program, hand control to it.
    if (peek(EMBED_BASE) == EMBED_MAGIC)
    {
        kernel_exec_embedded(EMBED_BASE + EMBED_DATA_OFFSET,
                             peek(EMBED_BASE + EMBED_LEN_OFFSET));
    }

    tty_puts("No embedded program; shell image is separate.\r\n");
    while (1)
    {
    }
}
