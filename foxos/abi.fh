// abi.fh - FoxOS syscall numbers and shared ABI constants
// -------------------------------------------------------
// Included by the user library and by the resident kernel. Keep this file
// free of code so both sides cannot drift apart.

// --- System calls -----------------------------------------------------------

u32 SYS_EXIT            = 0;
u32 SYS_WRITE           = 1;
u32 SYS_READ            = 2;
u32 SYS_OPEN            = 3;
u32 SYS_CLOSE           = 4;
u32 SYS_LSEEK           = 5;
u32 SYS_SBRK            = 6;
u32 SYS_GETPID          = 7;
u32 SYS_FORK            = 8;
u32 SYS_EXEC            = 9;
u32 SYS_WAIT            = 10;
u32 SYS_GETPPID         = 11;
u32 SYS_YIELD           = 12;

// FoxFS compatibility calls. They keep the existing path/entry API usable
// from user mode without exposing kernel memory.
u32 SYS_FS_RESOLVE      = 20;
u32 SYS_FS_CREATE       = 21;
u32 SYS_FS_ENTRY        = 22;
u32 SYS_FS_WRITE_ENTRY  = 23;
u32 SYS_FS_REMOVE       = 24;

// --- Error numbers (Y register) --------------------------------------------

u32 SYS_ERR             = 0xFFFFFFFF;
u32 ENOENT              = 2;
u32 ECHILD              = 10;
u32 EAGAIN              = 11;
u32 ENOMEM              = 12;
u32 EBADF               = 9;
u32 EINVAL              = 22;
u32 EFBIG               = 27;
u32 EMFILE              = 24;

// --- Open flags -------------------------------------------------------------

u32 O_CREAT             = 1;
u32 O_TRUNC             = 2;

// --- User virtual address windows ------------------------------------------

u32 ABI_USER_DATA       = 0x0000A000;
u32 ABI_USER_DATA_END   = 0x0000EC78;
u32 ABI_USER_CODE       = 0x00100000;
u32 ABI_USER_CODE_END   = 0x00900000;
u32 ABI_USER_HEAP       = 0x20000000;
u32 ABI_USER_HEAP_END   = 0x20400000;
u32 ABI_USER_STACK      = 0x0000EC77;

// --- Trap frame -------------------------------------------------------------

u32 ABI_TRAP            = 0x00070000;
u32 ABI_FRAME_WORDS     = 40;
u32 ABI_KSTACK          = 0x0000EC77;

// Trap causes written to the first trap-frame word. Cause 2 is host-only:
// the CPU raises it for Super+Q and FoxOS handles it before syscall dispatch.
u32 ABI_TRAP_SYS        = 0;
u32 ABI_TRAP_TIMER      = 1;
u32 ABI_TRAP_QUIT       = 2;

// Standard file descriptors.
u32 ABI_STDIN           = 0;
u32 ABI_STDOUT          = 1;
u32 ABI_STDERR          = 2;
