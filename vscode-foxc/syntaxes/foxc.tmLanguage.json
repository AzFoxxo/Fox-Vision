{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "FoxC",
    "scopeName": "source.foxc",
    "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#builtins" },
        { "include": "#literals" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#functionCalls" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.foxc",
                    "match": "//.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.foxc",
                    "match": "\\b(?:if|else|while|return)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "u32 gets its own scope so themes can distinguish it from u8/u16",
                    "name": "storage.type.u32.foxc",
                    "match": "\\bu32\\b"
                },
                {
                    "name": "storage.type.foxc",
                    "match": "\\b(?:u8|u16|void)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "comment": "V2.0 em2_am1-only builtins",
                    "name": "support.function.builtin.v2.foxc",
                    "match": "\\b(?:am|set_am|em|set_em)\\b"
                },
                {
                    "comment": "Extended-mode port builtins",
                    "name": "support.function.builtin.port.foxc",
                    "match": "\\b(?:in_port|out_port)\\b"
                },
                {
                    "comment": "Core builtins (all modes)",
                    "name": "support.function.builtin.foxc",
                    "match": "\\b(?:poke|peek|wait|cyc|vblank|os_start|os_return)\\b"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "string.quoted.double.foxc",
                    "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*\""
                },
                {
                    "name": "constant.character.foxc",
                    "match": "'(?:\\\\.|[^'\\\\\\r\\n])*'"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.decimal.foxc",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.foxc",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.foxc",
                    "match": "&&|\\|\\|"
                },
                {
                    "name": "keyword.operator.bitshift.foxc",
                    "match": "<<|>>"
                },
                {
                    "name": "keyword.operator.arithmetic.foxc",
                    "match": "[+\\-*/&|^~]"
                },
                {
                    "name": "keyword.operator.assignment.foxc",
                    "match": "="
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.section.block.foxc",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.section.group.foxc",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.section.brackets.foxc",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.separator.comma.foxc",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.foxc",
                    "match": ";"
                },
                {
                    "name": "storage.modifier.pointer.foxc",
                    "match": "(?<=\\b(?:u8|u16|u32|void)(?:\\s*\\*)*\\s*)\\*"
                }
            ]
        },
        "functionCalls": {
            "patterns": [
                {
                    "name": "entity.name.function.foxc",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
                }
            ]
        }
    }
}
