// FoxOS foreground-program test.
//
// Build this image at $4000 and install its raw words into a FoxOS file
// slot. Run it from the shell with:
//
//   run /bin/ostest
//
// Hold Escape or Enter to return to FoxOS.

u16 VRAM_TOP = 65535;
u16 PIXELS = 600;
u16 frame = 0;

void puts(u8 *text)
{
    while (*text != 0)
    {
        out_port(4, *text);
        text = text + 1;
    }
}

void draw_frame(u16 phase)
{
    u16 address = VRAM_TOP;
    u16 i = 0;
    u16 color = 0;

    while (i < PIXELS)
    {
        color = (i + phase) & 15;
        poke(address, color);
        address = address - 1;
        i = i + 1;
    }
}

void main()
{
    puts("\r\nFoxOS program test started at $4000.\r\n");
    puts("Animated VRAM pattern active; press Escape or Enter to exit.\r\n");

    while (1)
    {
        draw_frame(frame);
        frame = (frame + 1) & 15;
        wait(3000);

        u16 key = in_port(2) & 255;
        if (key == 40 || key == 28)
        {
            os_return();
        }
    }
}
