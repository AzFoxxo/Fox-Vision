{
    "name": "fox16asm-highlighter",
    "displayName": "Fox16ASM Highlighter",
    "description": "Syntax highlighting, completions, hover docs, and validation for Fox Vision .f16 assembly files. Supports legacy, extended (V1.10), and V2.0 em2_am1 modes including 32-bit sub-registers and full port range.",
    "version": "0.1.0",
    "publisher": "azfoxxo",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:fox16asm"
    ],
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "fox16asm",
                "aliases": [
                    "Fox16ASM",
                    "Fox Vision Assembly"
                ],
                "extensions": [
                    ".f16"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "fox16asm",
                "scopeName": "source.fox16asm",
                "path": "./syntaxes/fox16asm.tmLanguage.json"
            }
        ]
    }
}